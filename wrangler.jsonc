{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locketgold-info",
  "main": "./worker/index.js",
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_date": "2026-09-29",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "SITE_URL": "https://locketgold.info",
    "NODNS_API_BASE_URL": "https://ctv.nodns.vn",
    "NODNS_CTV_PORTAL": "false",
    "NODNS_ADMIN_AUTH": "false",
    "NODNS_CREDENTIALS_ENABLED": "true",
    "ADMIN_USERNAME": "admin",
    "ADMIN_CREDENTIALS_ENABLED": "true",
    "BANK_NAME": "MB Bank",
    "BANK_BIN": "970422",
    "BANK_ACCOUNT": "5565662518",
    "BANK_ACCOUNT_NAME": "HO DANG ANH DUC"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/android/*", "/sitemap.xml", "/bai-viet/*"]
  },

  "routes": [
    { "pattern": "locketgold.info", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locketgold-db",
      "database_id": "9586b6f0-bd60-4766-8551-b3225f4d195e",
      "migrations_dir": "migrations"
    }
  ]
}
